# Variables de entorno — DORA Secure Registry
# Copia este archivo como .env y rellena tus valores reales

# ──────────────────────────────────────────────
# EmailJS — Envío de códigos OTP por correo
# Obtén estos valores en: https://www.emailjs.com
# ──────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Clave de encriptación del sistema
# Cambia esto por una cadena larga y aleatoria
# Ejemplo: openssl rand -hex 32
# ⚠️ NO compartas este valor ni lo subas a GitHub
# ──────────────────────────────────────────────
VITE_SYSTEM_ENCRYPTION_KEY=cambia_esto_por_una_clave_larga_y_aleatoria_32chars

# ──────────────────────────────────────────────
# Supabase — Base de datos compartida en la nube
# Obtén estos valores en: https://supabase.com
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Modo desarrollo (true = muestra el código en pantalla; false = envía correo real)
VITE_DEV_MODE=false


